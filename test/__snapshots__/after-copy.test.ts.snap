// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`after_copy > generates as before without after_copy 1`] = `
{
  "dataset/ds_erp_erp_erp.json": "{
	"name": "ds_erp_erp_erp",
	"properties": {
		"type": "SqlServerTable",
		"linkedServiceName": {
			"referenceName": "ls_erp_erp_erp",
			"type": "LinkedServiceReference"
		}
	}
}
",
  "dataset/ds_erp_landing.json": "{
	"name": "ds_erp_landing",
	"properties": {
		"type": "Parquet",
		"linkedServiceName": {
			"referenceName": "ls_erp_landing",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"folder": {
				"type": "string"
			},
			"file": {
				"type": "string"
			}
		},
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileSystem": "landing",
				"folderPath": {
					"value": "@dataset().folder",
					"type": "Expression"
				},
				"fileName": {
					"value": "@dataset().file",
					"type": "Expression"
				}
			},
			"compressionCodec": "snappy"
		}
	}
}
",
  "linkedService/ls_erp_erp_erp.json": "{
	"name": "ls_erp_erp_erp",
	"properties": {
		"type": "SqlServer",
		"typeProperties": {
			"server": "erp-sql01.corp.local",
			"database": "erp",
			"encrypt": "mandatory",
			"trustServerCertificate": false,
			"authenticationType": "SQL",
			"userName": "ingest_reader",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "ls_erp_keyvault",
					"type": "LinkedServiceReference"
				},
				"secretName": "erp-sql-password"
			}
		},
		"connectVia": {
			"referenceName": "shir-erp",
			"type": "IntegrationRuntimeReference"
		}
	}
}
",
  "linkedService/ls_erp_keyvault.json": "{
	"name": "ls_erp_keyvault",
	"properties": {
		"type": "AzureKeyVault",
		"typeProperties": {
			"baseUrl": "https://kv-erp.vault.azure.net"
		}
	}
}
",
  "linkedService/ls_erp_landing.json": "{
	"name": "ls_erp_landing",
	"properties": {
		"type": "AzureBlobFS",
		"typeProperties": {
			"url": "https://erplake.dfs.core.windows.net"
		}
	}
}
",
  "pipeline/pl_erp_erp.json": "{
	"name": "pl_erp_erp",
	"properties": {
		"activities": [
			{
				"name": "copy_invoices",
				"type": "Copy",
				"inputs": [
					{
						"referenceName": "ds_erp_erp_erp",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_erp_landing",
						"type": "DatasetReference",
						"parameters": {
							"folder": "erp/erp.dbo.Invoices",
							"file": "@{concat(formatDateTime(pipeline().parameters.windowStart, 'yyyyMMddHHmmss'), '_', pipeline().RunId, '.parquet')}"
						}
					}
				],
				"typeProperties": {
					"source": {
						"type": "SqlSource",
						"sqlReaderQuery": "SELECT [invoice_id], [amount], [modified_at] FROM [dbo].[Invoices]"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					}
				}
			}
		],
		"parameters": {
			"windowStart": {
				"type": "string"
			},
			"windowEnd": {
				"type": "string"
			}
		},
		"annotations": [
			"Generated by Ingestron from the erp definitions"
		]
	}
}
",
  "trigger/tr_erp_erp.json": "{
	"name": "tr_erp_erp",
	"properties": {
		"type": "TumblingWindowTrigger",
		"runtimeState": "Stopped",
		"typeProperties": {
			"frequency": "Hour",
			"interval": 24,
			"startTime": "2026-10-01T00:00:00Z",
			"maxConcurrency": 1,
			"retryPolicy": {
				"count": 2,
				"intervalInSeconds": 300
			}
		},
		"pipeline": {
			"pipelineReference": {
				"referenceName": "pl_erp_erp",
				"type": "PipelineReference"
			},
			"parameters": {
				"windowStart": "@trigger().outputs.windowStartTime",
				"windowEnd": "@trigger().outputs.windowEndTime"
			}
		}
	}
}
",
}
`;
