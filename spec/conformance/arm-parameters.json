  {
    "name": "a given name replaces the property's, or stands alone after the resource's after a dash (Microsoft's documented example)",
    "definition": {
      "Microsoft.DataFactory/factories/triggers": {
        "properties": {
          "typeProperties": {
            "recurrence": {
              "interval": "=:triggerSuffix:int",
              "frequency": "=:-freq"
            }
          }
        }
      }
    },
    "resources": {
      "trigger/tr.json": {
        "name": "tr",
        "properties": {
          "typeProperties": {
            "recurrence": {
              "interval": 1,
              "frequency": "Day"
            }
          }
        }
      }
    },
    "parameters": [
      {
        "name": "tr_properties_typeProperties_recurrence_triggerSuffix",
        "file": "trigger/tr.json",
        "path": ["properties", "typeProperties", "recurrence", "interval"],
        "type": "int"
      },
      {
        "name": "tr_freq",
        "file": "trigger/tr.json",
        "path": ["properties", "typeProperties", "recurrence", "frequency"],
        "type": "string"
      }
    ]
  },
