[
  {
    "name": "an activity's value is named by the indexes of the activities, not by the arrays' keys; in an expression object, its value is replaced",
    "definition": {
      "Microsoft.DataFactory/factories/pipelines": {
        "properties": {
          "activities": [
            {
              "typeProperties": {
                "url": "-"
              }
            }
          ]
        }
      }
    },
    "resources": {
      "pipeline/pl_x.json": {
        "name": "pl_x",
        "properties": {
          "activities": [
            {
              "name": "start",
              "typeProperties": {
                "url": "https://a/start"
              }
            },
            {
              "name": "stop",
              "typeProperties": {
                "url": {
                  "value": "@concat('https://a', 'stop')",
                  "type": "Expression"
                }
              }
            },
            {
              "name": "loop",
              "typeProperties": {
                "activities": [
                  {
                    "name": "copy",
                    "outputs": [
                      {
                        "parameters": {
                          "folder": "x/y"
                        }
                      }
                    ],
                    "typeProperties": {
                      "source": {
                        "additionalColumns": [
                          {
                            "name": "_e",
                            "value": "dev"
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            }
          ],
          "parameters": {
            "tables": {
              "type": "array",
              "defaultValue": [
                {
                  "folder": "x/y"
                }
              ]
            }
          }
        }
      }
    },
    "parameters": [
      {
        "name": "pl_x_properties_0_typeProperties_url",
        "file": "pipeline/pl_x.json",
        "path": ["properties", "activities", 0, "typeProperties", "url"],
        "type": "string"
      },
      {
        "name": "pl_x_properties_1_typeProperties_url",
        "file": "pipeline/pl_x.json",
        "path": ["properties", "activities", 1, "typeProperties", "url", "value"],
        "type": "string"
      }
    ]
  },
